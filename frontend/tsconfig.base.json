{
  "compileOnSave": false,
  "angularCompilerOptions": {
    "strictTemplates": false
  },
  "compilerOptions": {
    "strict": false,
    "skipLibCheck": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "typeRoots": [
      "../node_modules/@types"
    ],
    "lib": [
      "es2020",
      "dom"
    ]
  }
}
