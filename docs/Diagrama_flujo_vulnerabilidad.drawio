        <mxCell id="nmmaDAJyDDN6s8_YKDrn-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;align=left;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&amp;nbsp;2. IMPORTACIÓN AUTOMÁTICA A DEFECTDOJO&lt;div&gt;&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;El job import-defectdojo (if: always())&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: 400;&quot;&gt;envía el informe vía API REST&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;&amp;nbsp;(POST /api/v2/reimport-scan/) usando GitHub Secrets.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;&amp;nbsp;Deduplica hallazgos repetidos y los agrupa en Product / Engagement&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="420" x="250" y="140" as="geometry" />
        </mxCell>
