        </mxCell>
        <mxCell id="nmmaDAJyDDN6s8_YKDrn-28" edge="1" parent="1" source="nmmaDAJyDDN6s8_YKDrn-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="nmmaDAJyDDN6s8_YKDrn-27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nmmaDAJyDDN6s8_YKDrn-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;fontStyle=1;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&amp;nbsp; &amp;nbsp;&lt;div&gt;&amp;nbsp; &amp;nbsp;3. TRIAJE EN DEFECTDOJO&lt;/div&gt;&lt;div&gt;&amp;nbsp; &lt;span style=&quot;font-weight: normal;&quot;&gt;&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;El Security Team revisa los hallazgos activos, analiza su&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-weight: normal; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;explotabilidad real y los prioriza&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="490" x="220" y="570" as="geometry" />
        </mxCell>
        <mxCell id="nmmaDAJyDDN6s8_YKDrn-31" edge="1" parent="1" source="nmmaDAJyDDN6s8_YKDrn-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="nmmaDAJyDDN6s8_YKDrn-29">
