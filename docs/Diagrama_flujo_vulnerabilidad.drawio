        <mxCell id="nmmaDAJyDDN6s8_YKDrn-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;align=left;fontStyle=1" value="&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;div&gt;&amp;nbsp; Severidad MEDIUM, LOW o INFO&lt;/div&gt;&lt;div&gt;&amp;nbsp; Acción CI: &lt;span style=&quot;font-weight: normal;&quot;&gt;el pipeline no se ve afectado&amp;nbsp; &amp;nbsp; y continúa&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&amp;nbsp; &lt;/span&gt;DefectDojo: &lt;span style=&quot;font-weight: normal;&quot;&gt;queda registrado como&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; hallazgo activo sin bloquear&lt;/span&gt;&lt;/div&gt;" vertex="1">
