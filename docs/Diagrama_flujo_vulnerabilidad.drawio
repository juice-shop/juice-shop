        </mxCell>
        <mxCell id="nmmaDAJyDDN6s8_YKDrn-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;align=left;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;div&gt;&amp;nbsp; GATE A: MODO AVISO (continue-on-error: true)&lt;/div&gt;&lt;div&gt;&amp;nbsp; Acción CI: &lt;span style=&quot;font-weight: normal;&quot;&gt;el pipeline continúa hacia las pruebas&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; DAST&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&amp;nbsp; &lt;/span&gt;Aviso: &lt;span style=&quot;font-weight: normal;&quot;&gt;genera anotación Warning en GitHub&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Actions (Summary / PR)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="290" x="860" y="240" as="geometry" />
        </mxCell>
        <mxCell id="nmmaDAJyDDN6s8_YKDrn-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="No" vertex="1">
          <mxGeometry height="30" width="60" x="795" y="270" as="geometry" />
        </mxCell>
        <mxCell id="nmmaDAJyDDN6s8_YKDrn-26" edge="1" parent="1" source="nmmaDAJyDDN6s8_YKDrn-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="nmmaDAJyDDN6s8_YKDrn-22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nmmaDAJyDDN6s8_YKDrn-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;align=left;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;div&gt;&amp;nbsp; GATE B: MODO BLOQUEANTE (exit 1)&lt;/div&gt;&lt;div&gt;&amp;nbsp; Acción CI: &lt;span style=&quot;font-weight: normal;&quot;&gt;el pipeline se detiene (Status: Failed) y&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; bloquea el despliegue y el merge del Pull Request&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&amp;nbsp; &lt;/span&gt;Aviso: &lt;span style=&quot;font-weight: normal;&quot;&gt;notificación automática al autor del commit/PR y&amp;nbsp; &amp;nbsp; &amp;nbsp; al Security Team&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="315" x="542.5" y="400" as="geometry" />
        </mxCell>
