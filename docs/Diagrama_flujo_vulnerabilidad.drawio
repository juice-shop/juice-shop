        <mxCell id="nmmaDAJyDDN6s8_YKDrn-33" edge="1" parent="1" source="nmmaDAJyDDN6s8_YKDrn-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="nmmaDAJyDDN6s8_YKDrn-32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nmmaDAJyDDN6s8_YKDrn-27" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" value="¿Es un falso positivo?" vertex="1">
          <mxGeometry height="80" width="132.5" x="398.75" y="680" as="geometry" />
        </mxCell>
        <mxCell id="nmmaDAJyDDN6s8_YKDrn-29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;align=left;fontStyle=1" value="&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;div&gt;&amp;nbsp; FALSO POSITIVO&lt;/div&gt;&lt;div&gt;&amp;nbsp; &lt;span style=&quot;font-weight: normal;&quot;&gt;Se marca como &quot;False Positive&quot; en DefectDojo&amp;nbsp; &amp;nbsp; &amp;nbsp; con justificación.&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&amp;nbsp; Se ajusta o excluye la regla en la herramienta&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; correspondiente (.semgrepignore, .trivyignore o&amp;nbsp; &amp;nbsp; regla de OWASP ZAP)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="270" x="70" y="660" as="geometry" />
        </mxCell>
        <mxCell id="nmmaDAJyDDN6s8_YKDrn-35" edge="1" parent="1" source="nmmaDAJyDDN6s8_YKDrn-32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="nmmaDAJyDDN6s8_YKDrn-34">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nmmaDAJyDDN6s8_YKDrn-32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;align=left;fontStyle=1" value="&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;div&gt;&amp;nbsp; VULNERABILIDAD REAL&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;Se prioriza y se asigna a un miembro del equipo.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&amp;nbsp; Se corrige el código fuente, la dependencia o el&amp;nbsp; &amp;nbsp; Dockerfile y se realiza un nuevo commit / push.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="270" x="610" y="670" as="geometry" />
        </mxCell>
