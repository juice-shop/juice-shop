        <mxCell id="nmmaDAJyDDN6s8_YKDrn-34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; 4. VERIFICACIÓN Y CIERRE AUTOMÁTICO&lt;/div&gt;&lt;div&gt;&amp;nbsp; &lt;span style=&quot;font-weight: normal;&quot;&gt;El nuevo push relanza el pipeline (vuelve al paso 1).&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&amp;nbsp; Al reimportar en DefectDojo (reimport-scan), si la&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; vulnerabilidad ya no se detecta, DefectDojo la marca&amp;nbsp; &amp;nbsp; &amp;nbsp; automáticamente como &quot;Mitigated&quot;.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="300" x="595" y="827" as="geometry" />
