# Copien este archivo a .env y ajústenlo a su aplicación:  cp .env.example .env
# No suban .env al repositorio si llegan a poner secretos en él.

# ── A dónde reenvía el WAF ────────────────────────────────────────────────
# Opción A (app corriendo en su máquina): host.docker.internal + el puerto de su app
#   Ej.: API en Express en el puerto 3000  ->  http://host.docker.internal:3000
#   Ej.: Django en el puerto 8000          ->  http://host.docker.internal:8000
# Opción B (app como servicio en docker-compose.yml):  http://app:<puerto interno>
APP_BACKEND=http://host.docker.internal:3000

# Puerto donde queda el WAF en su máquina. Cámbienlo si su app ya usa el 8080.
WAF_PORT=8080

# Interfaz donde escucha el WAF. 127.0.0.1 = solo esta laptop (recomendado).
# 0.0.0.0 solo si el Red Team ataca desde otra laptop en una red privada del grupo
# (hotspot propio), nunca en la red de la Universidad.
WAF_BIND=127.0.0.1

# DetectionOnly (registra, no bloquea) | On (bloquea con 403, Hito 3)
MODSEC_RULE_ENGINE=DetectionOnly

# Métodos HTTP que acepta su aplicación. El CRS solo permite GET HEAD POST OPTIONS.
# Si su API REST usa PUT, PATCH o DELETE, agréguenlos (solo los que usen), por ejemplo:
#   ALLOWED_METHODS=GET HEAD POST OPTIONS PUT PATCH DELETE
ALLOWED_METHODS=GET HEAD POST OPTIONS

# Nivel de paranoia del OWASP CRS (1-4). Más alto = más detecciones y más falsos positivos.
BLOCKING_PARANOIA=1

# Opcional: carpeta donde su aplicación escribe sus logs (README, sección 7)
APP_LOGS_DIR=./app-logs

# Versión del Elastic Stack (Elasticsearch, Kibana y Filebeat deben coincidir)
ELASTIC_VERSION=9.3.3
